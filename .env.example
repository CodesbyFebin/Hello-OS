DATABASE_URL="file:./db/custom.db"
HELLO_MCP_URL="http://localhost:3030"
HELLO_PUBLIC_URL="http://localhost:3000"
HELLO_ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:3030,http://127.0.0.1:3030"

# Operator token for approvals, kill switch, scheduler, knowledge roles and sandbox (PRs #5, #6, #12, #14).
# Unset = dev mode (anyone who can reach the server can act as operator).
# HELLO_OPERATOR_TOKEN=""
# HMAC secret for POST /api/integrations/webhook (PR #7). Route returns 503 until set.
# HELLO_WEBHOOK_SECRET=""
# Optional read-only GitHub token for the MCP connector.github.read tool (PR #7).
# GITHUB_TOKEN=""
# MCP service port override (PR #7). Default 3030.
# HELLO_MCP_PORT="3030"
