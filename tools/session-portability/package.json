    "sandbox:seed": "bun run scripts/sandbox/seed.ts",
    "demo:reset": "bun run scripts/demo/reset-destinations.ts"
  },
  "dependencies": {
    "zod": "^3.23.8",
    "@opentui/core": "^0.4.2",
    "@opentui/solid": "^0.4.2",
    "solid-js": "^1.9.13"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.5.0"
  }
}
