{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codesbyfebin.github.io/Hello-OS/schemas/hello-task-v1.schema.json",
  "title": "HELLO OS Task Contract v1",
  "description": "Static task description schema. Passing this schema does not authorize capabilities or execute a task.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "goal", "scope", "success", "budgets", "approval", "termination"],
  "properties": {
    "schema": { "const": "hello.task/v1" },
    "goal": { "type": "string", "minLength": 1, "maxLength": 500, "pattern": ".*\\S.*" },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["include"],
      "properties": {
        "include": { "$ref": "#/$defs/descriptionList" },
        "exclude": { "$ref": "#/$defs/optionalDescriptionList" }
      }
    },
    "capabilities": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "type": "string", "maxLength": 64, "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$" }
    },
    "constraints": { "$ref": "#/$defs/constraintList" },
    "success": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "criteria"],
      "properties": {
        "kind": { "enum": ["measurable", "human_review"] },
        "criteria": { "$ref": "#/$defs/criteriaList" }
      }
    },
    "failureCriteria": { "$ref": "#/$defs/failureCriteriaList" },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tokens", "toolCalls", "wallClockSeconds"],
      "properties": {
        "tokens": { "$ref": "#/$defs/tokenBudget" },
        "toolCalls": { "$ref": "#/$defs/toolBudget" },
        "wallClockSeconds": { "$ref": "#/$defs/timeBudget" }
      }
    },
    "approval": { "enum": ["required", "not_required"] },
    "termination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["onSuccess", "onFailure", "onTimeout"],
      "properties": {
        "onSuccess": { "const": "report" },
        "onFailure": { "enum": ["report", "escalate"] },
        "onTimeout": { "enum": ["fail", "pause"] }
      }
    }
  },
  "$defs": {
    "descriptionList": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 300, "pattern": ".*\\S.*" }
    },
    "optionalDescriptionList": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 300, "pattern": ".*\\S.*" }
    },
    "constraintList": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 500, "pattern": ".*\\S.*" }
    },
    "failureCriteriaList": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 500, "pattern": ".*\\S.*" }
    },
    "criteriaList": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 500, "pattern": ".*\\S.*" }
    },
    "tokenBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["perStep", "total"],
      "properties": {
        "perStep": { "type": "integer", "minimum": 1, "maximum": 10000000 },
        "total": { "type": "integer", "minimum": 1, "maximum": 10000000 }
      }
    },
    "toolBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["perStep", "total"],
      "properties": {
        "perStep": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "total": { "type": "integer", "minimum": 1, "maximum": 10000 }
      }
    },
    "timeBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["perStep", "total"],
      "properties": {
        "perStep": { "type": "integer", "minimum": 1, "maximum": 86400 },
        "total": { "type": "integer", "minimum": 1, "maximum": 86400 }
      }
    }
  }
}
