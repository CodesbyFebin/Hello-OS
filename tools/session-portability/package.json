{
  "name": "@hello-os/session-portability",
  "version": "0.0.1",
  "private": true,
  "description": "Local session portability utility for HELLO OS.",
  "license": "MIT",
  "homepage": "https://github.com/CodesbyFebin/Hello-OS",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CodesbyFebin/Hello-OS.git"
  },
  "type": "module",
  "bin": {
    "hello-sessions": "./src/cli.ts"
  },
  "scripts": {
    "cli": "bun run src/cli.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "sandbox:backup": "bun run scripts/sandbox/backup.ts",
    "sandbox:restore": "bun run scripts/sandbox/restore.ts",
