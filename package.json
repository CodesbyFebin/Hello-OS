{
  "name": "nextjs_tailwind_shadcn_ts",
  "version": "0.2.1",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000 2>&1 | tee dev.log",
    "build": "next build && cp -r .next/static .next/standalone/.next/ && cp -r public .next/standalone/ && cp -r sample-repo .next/standalone/",
    "start": "NODE_ENV=production node .next/standalone/server.js",
    "mcp": "bun --hot mini-services/hello-mcp/index.ts",
    "lint": "eslint .",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset",
    "test:aml": "node --experimental-strip-types --test tests/aml.test.mjs",
    "test:evolution": "node --experimental-strip-types --test tests/evolution.test.mjs",
    "test:secrets": "prisma db push --skip-generate && node --experimental-strip-types --test tests/secrets.test.mjs",
    "test:gate": "prisma db push --skip-generate && node --experimental-strip-types --import ./tests/register.mjs --test tests/gate.test.mjs",
    "test:scheduler": "prisma db push --skip-generate && node --experimental-strip-types --import ./tests/register.mjs --test tests/scheduler-delegation.test.mjs",
    "test:connectors": "node --experimental-strip-types --experimental-sqlite --test tests/connectors.test.mjs",
    "test:snapshots": "prisma db push --skip-generate && node --experimental-strip-types --import ./tests/register.mjs --test tests/snapshots-failures.test.mjs",
    "test:cache": "prisma db push --skip-generate && node --experimental-strip-types --import ./tests/register.mjs --test tests/cache-knowledge.test.mjs",
    "test:sandbox": "node --experimental-strip-types --import ./tests/register.mjs --test tests/sandbox.test.mjs",
    "test:roadmap": "node --experimental-strip-types --test tests/roadmap.test.mjs",
    "test:consensus": "prisma db push --skip-generate && node --experimental-strip-types --import ./tests/register.mjs --test tests/consensus-treasury.test.mjs",
    "test:sync": "prisma db push --skip-generate && node --experimental-strip-types --import ./tests/register.mjs --test tests/sync.test.mjs",
    "test:docs": "prisma db push --skip-generate && node --experimental-strip-types --import ./tests/register.mjs --test tests/docs.test.mjs",
    "routes:manifest": "node scripts/gen-route-manifest.mjs",
    "test:design": "node --experimental-strip-types --test tests/design.test.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:aml && npm run test:evolution && npm run test:secrets && npm run test:gate && npm run test:scheduler && npm run test:connectors && npm run test:snapshots && npm run test:cache && npm run test:sandbox && npm run test:roadmap && npm run test:consensus && npm run test:truth && npm run test:ai",
    "test:truth": "node --test tests/no-fake-data.test.mjs",
    "test:ai": "prisma db push --skip-generate && node --experimental-strip-types --import ./tests/register.mjs --test tests/ai-provider.test.mjs",
    "test:mcp": "prisma db push --skip-generate && node --experimental-strip-types --import ./tests/register.mjs --test tests/mcp-inprocess.test.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
