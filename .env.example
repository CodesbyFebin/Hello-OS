DATABASE_URL="file:./db/custom.db"
HELLO_PUBLIC_URL="http://localhost:3000"
HELLO_ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:3030,http://127.0.0.1:3030"

# Operator token for approvals, kill switch, scheduler, knowledge roles and sandbox (PRs #5, #6, #12, #14).
# Unset + local dev = dev mode (anyone who can reach the server can act as operator).
# Unset + production (NODE_ENV=production or VERCEL) = operator actions fail closed with 503.
# HELLO_OPERATOR_DEV_MODE=1 re-enables dev mode in production builds (local Docker only; never on a public host).
# HELLO_OPERATOR_TOKEN=""
# HMAC secret for POST /api/integrations/webhook (PR #7). Route returns 503 until set.
# HELLO_WEBHOOK_SECRET=""
# Optional read-only GitHub token for the MCP connector.github.read tool (PR #7).
# GITHUB_TOKEN=""
# Optional standalone MCP sidecar port. The app's in-process MCP endpoint needs no sidecar.
# HELLO_MCP_PORT="3030"

# AI provider (OpenAI-compatible). Unset = AI features return 503 NO_AI_PROVIDER.
# HELLO_AI_PROVIDER=openrouter        # openrouter | kilo | ollama | custom
# Local Ollama (optional, key not needed): HELLO_AI_PROVIDER=ollama HELLO_AI_MODEL=<pulled model>
# LiteLLM/Bifrost gateway: HELLO_AI_PROVIDER=custom HELLO_AI_BASE_URL=http://127.0.0.1:4000/v1 HELLO_AI_API_KEY=<gateway key>
# HELLO_AI_API_KEY=                   # OpenRouter or Kilo Code gateway key
# HELLO_AI_MODEL=google/gemma-4-31b-it:free
# HELLO_AI_BASE_URL=                  # optional override; required for custom
# HELLO_AI_TIMEOUT_MS=30000
# HELLO_AI_MAX_RETRIES=2
# HELLO_AI_CREDITS_PER_CALL=1         # credits (H) debited per agent-scoped call

# Turso / libSQL (Vercel). DATABASE_URL=libsql://<db>-<org>.turso.io switches to the libSQL driver adapter.
# See docs/DEPLOY-VERCEL.md. Local dev keeps DATABASE_URL="file:./db/custom.db".
# TURSO_AUTH_TOKEN=""
